# =======================================================
# CONFIGURAÇÕES DO SERVIDOR SPOTIFY OVERLAY (WHALE OBS)
# =======================================================

# Porta onde o servidor vai rodar (ex: 3000 ou fornecida pela nuvem como Railway/Render)
PORT=3000

# Credenciais oficiais da sua aplicação no Spotify Developer
# Crie seu app gratuito em: https://developer.spotify.com/dashboard
# IMPORTANTE: No painel do Spotify Developer, em "Redirect URIs", adicione:
# http://localhost:3000/auth/spotify/callback
# (e quando fizer o deploy, adicione também a URL do seu domínio, ex: https://seu-app.up.railway.app/auth/spotify/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# URL Base pública (opcional, deixe em branco para detecção automática pelo domínio do request)
BASE_URL=
